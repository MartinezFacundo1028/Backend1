<div class="cart-container">
    <h1>Carrito de Compras</h1>

    {{#if cart.length}}
        <ul>
            {{#each cart}}
                <li>
                    <strong>{{this.title}}</strong>: ${{this.price}} (Stock: {{this.stock}})
                    <button onclick="updateCart('{{this._id}}', 'add')">+</button>
                    <button onclick="updateCart('{{this._id}}', 'subtract')">-</button>
                    <button onclick="updateCart('{{this._id}}', 'remove')">Eliminar</button>
                </li>
            {{/each}}
        </ul>

        <div class="total">
            <p>Total: ${{totalAmount}}</p>
            <form action="/purchase" method="POST">
                <input type="hidden" name="amount" value="{{totalAmount}}">
                <input type="email" name="purchaser" placeholder="Ingresa tu correo" required>
                <button type="submit">Formalizar Compra</button>
            </form>
        </div>
    {{else}}
        <p>No hay productos en el carrito.</p>
    {{/if}}
</div>

<script>
    function updateCart(productId, action) {
        fetch(`/cart/update`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({ productId, action }),
        })
        .then(response => response.json())
        .then(data => {
            // Actualiza la vista del carrito aquí, por ejemplo, recargando la página o actualizando el DOM
            location.reload(); // Recargar la página para ver los cambios
        })
        .catch((error) => {
            console.error('Error:', error);
        });
    }
</script> 